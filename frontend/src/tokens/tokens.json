{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "IFC Editor Spatial Canvas Design Tokens",
  "version": "1.0.0",
  "description": "DTCG-compliant tokens for Minimalist Spatial Canvas BIM Editor",
  "color": {
    "surface": {
      "canvas": { "value": "#0b0d10", "type": "color", "description": "100% Edge-to-edge 3D viewport canvas background" },
      "dock": { "value": "#15181e", "type": "color", "description": "Floating HUD and tool dock background" },
      "dock_translucent": { "value": "rgba(21, 24, 30, 0.85)", "type": "color", "description": "Frosted glass dock surface" },
      "control": { "value": "#1f242d", "type": "color", "description": "Interactive button and input background" },
      "control_hover": { "value": "#2b323e", "type": "color", "description": "Hovered control background" },
      "control_active": { "value": "#353d4c", "type": "color", "description": "Active pressed control background" }
    },
    "border": {
      "subtle": { "value": "#252b36", "type": "color", "description": "Dock and panel hairline border" },
      "strong": { "value": "#3a4354", "type": "color", "description": "Active selection or hovered border" },
      "focus": { "value": "#22d3ee", "type": "color", "description": "Accessible focus ring" }
    },
    "text": {
      "primary": { "value": "#f8fafc", "type": "color", "description": "High-contrast headings, values, and titles" },
      "secondary": { "value": "#94a3b8", "type": "color", "description": "Labels, descriptions, and metadata" },
      "muted": { "value": "#64748b", "type": "color", "description": "Inactive tabs, shortcuts, and placeholder text" },
      "inverse": { "value": "#0b0d10", "type": "color", "description": "Text over primary affirmative accents" }
    },
    "action": {
      "primary": { "value": "#22d3ee", "type": "color", "description": "Affirmative primary commit action" },
      "primary_hover": { "value": "#06b6d4", "type": "color", "description": "Hovered primary commit" },
      "primary_text": { "value": "#0b0d10", "type": "color", "description": "High contrast text on primary action" },
      "danger": { "value": "#dc2626", "type": "color", "description": "Destructive delete/clear action" },
      "danger_hover": { "value": "#b91c1c", "type": "color", "description": "Hovered destructive action" },
      "danger_text": { "value": "#ffffff", "type": "color", "description": "High-contrast text on destructive action" },
      "warning": { "value": "#f59e0b", "type": "color", "description": "Soft-lock warning and caution indicators" }
    },
    "bim": {
      "wall": { "value": "#94a3b8", "type": "color" },
      "slab": { "value": "#64748b", "type": "color" },
      "column": { "value": "#f59e0b", "type": "color" },
      "door": { "value": "#a855f7", "type": "color" },
      "window": { "value": "#38bdf8", "type": "color" },
      "measurement_laser": { "value": "#10b981", "type": "color" },
      "section_plane": { "value": "#f43f5e", "type": "color" }
    }
  },
  "spacing": {
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "6": { "value": "24px" },
    "8": { "value": "32px" }
  },
  "radius": {
    "badge": { "value": "2px" },
    "control": { "value": "6px" },
    "dock": { "value": "12px" },
    "modal": { "value": "16px" },
    "pill": { "value": "9999px" }
  },
  "shadow": {
    "hud": { "value": "0 8px 32px 0 rgba(0, 0, 0, 0.45)" },
    "control": { "value": "0 2px 4px 0 rgba(0, 0, 0, 0.25)" }
  },
  "contrast_audit_pairs": [
    {
      "fg_name": "text.primary",
      "fg": "#f8fafc",
      "bg_name": "surface.canvas",
      "bg": "#0b0d10",
      "min_ratio": 4.5
    },
    {
      "fg_name": "text.secondary",
      "fg": "#94a3b8",
      "bg_name": "surface.canvas",
      "bg": "#0b0d10",
      "min_ratio": 4.5
    },
    {
      "fg_name": "text.primary",
      "fg": "#f8fafc",
      "bg_name": "surface.dock",
      "bg": "#15181e",
      "min_ratio": 4.5
    },
    {
      "fg_name": "action.primary.text",
      "fg": "#0b0d10",
      "bg_name": "action.primary.bg",
      "bg": "#22d3ee",
      "min_ratio": 4.5
    },
    {
      "fg_name": "action.danger.text",
      "fg": "#ffffff",
      "bg_name": "action.danger.bg",
      "bg": "#dc2626",
      "min_ratio": 4.5
    }
  ]
}
